# ============================================================
# School Management System - Environment Configuration
# ============================================================
# Copy this file to .env and adjust values as needed.

# ---- Application ----
APP_NAME=School Management System
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_URL=http://localhost:8000
APP_LANGUAGE=ar
APP_DEFAULT_TIMEZONE=Asia/Riyadh

# ---- Security ----
SECRET_KEY=change-me-to-a-long-random-string-in-production
SESSION_COOKIE_NAME=sms_session
SESSION_MAX_AGE=86400
SESSION_SECURE=false
SESSION_HTTPONLY=true
SESSION_SAMESITE=lax

# Password hashing
PASSWORD_HASH_SCHEME=bcrypt

# ---- Database ----
DATABASE_URL=postgresql+asyncpg://sms_user:sms_password@localhost:5432/sms_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_ECHO=false

# ---- Redis (optional, for caching/rate limiting) ----
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=false

# ---- Email (optional, for notifications) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@school.edu

# ---- File Uploads ----
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# ---- Pagination Defaults ----
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# ---- Report Settings ----
REPORT_LINK_EXPIRY_DAYS=7
REPORT_LINK_SECRET=change-me-report-secret
